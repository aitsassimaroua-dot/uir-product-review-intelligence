# Copy this file to .env and fill the values.
# Never commit .env (already gitignored).

# --- LLM backend ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# CrewAI uses LiteLLM under the hood. Set MODEL to the routing string.
# Free Gemini options: gemini/gemini-1.5-flash (fast) or gemini/gemini-1.5-pro
MODEL=gemini/gemini-1.5-flash

# --- Optional: fall back to local Ollama instead of Gemini ---
# Uncomment, install Ollama (https://ollama.com), then `ollama pull llama3.1`
# MODEL=ollama/llama3.1
# OLLAMA_BASE_URL=http://localhost:11434

# --- Paths ---
MODEL_DIR=models/sentiment_bert
LOG_DIR=logs
OUTPUT_DIR=outputs

# --- Training ---
HF_DATASET=amazon_polarity
TRAIN_SUBSET=50000
EVAL_SUBSET=5000
BASE_MODEL=distilbert-base-uncased
NUM_LABELS=2
BATCH_SIZE=16
LEARNING_RATE=2e-5
NUM_EPOCHS=2
MAX_LENGTH=256

# --- Runtime ---
LOG_LEVEL=INFO
