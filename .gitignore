# Outputs: ignore generated briefs / runs, but keep eval artefacts in the repo
outputs/market_brief_*.md
outputs/run_*.json
!outputs/.gitkeep
!outputs/eval_*.png
!outputs/eval_*.txt
!outputs/eval_*.json

